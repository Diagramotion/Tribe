{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window permissions for Tribe local desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/tribe-runtime", "sidecar": true }]
    }
  ]
}
