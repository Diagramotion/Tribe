{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tribe",
  "version": "0.1.0",
  "identifier": "dev.tribe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run runtime:package && npm run desktop:prepare",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{
      "title": "Tribe",
      "width": 1440,
      "height": 960,
      "minWidth": 1100,
      "minHeight": 700
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4317 http://localhost:4317; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tribe-runtime"],
    "macOS": {
      "frameworks": ["./frameworks/libswift_Concurrency.dylib"]
    },
    "resources": {"../agents/": "agents/"}
  }
}
